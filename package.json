{
  "name": "globesense",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Travel discovery and matching platform",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @globesense/client --filter @globesense/server dev",
    "build": "corepack pnpm --filter @globesense/shared build && corepack pnpm --filter @globesense/server build && corepack pnpm --filter @globesense/client build",
    "lint": "eslint .",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,json,css}\"",
    "typecheck": "corepack pnpm --filter @globesense/shared build && corepack pnpm -r typecheck",
    "eval:ai": "corepack pnpm --filter @globesense/server eval:ai"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.0"
  },
  "packageManager": "pnpm@10.30.3"
}
